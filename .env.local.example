# Copia este archivo como .env.local y pega los valores de tu proyecto en Supabase
# (Project Settings → API → Project URL y anon public key)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Llave de Gemini para leer las fotos del menú (aistudio.google.com/apikey). Solo servidor.
GEMINI_API_KEY=
# Modelo con visión (opcional, por defecto gemini-2.5-flash)
# GEMINI_MODEL_MENU=gemini-2.5-flash
